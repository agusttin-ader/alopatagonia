# URL pública del sitio (SEO canonical, sitemap, robots).
# NEXT_PUBLIC_SITE_URL=https://www.alopatagonia.com

# Full WhatsApp link (optional). If set, overrides E164 + default message.
# NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5491112345678?text=Hola

# Número Argentina sin + ni espacios (opcional). Si no está definido, se usa el valor por defecto del sitio.
# NEXT_PUBLIC_WHATSAPP_E164=5491112345678

# URL completa de la tienda de invierno (solo https y host permitido).
# NEXT_PUBLIC_WINTER_STORE_URL=https://www.laguaridainstrumentos.com
